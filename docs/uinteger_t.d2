# uinteger_t: little-endian 64-bit limbs, and the algorithm each size gets.
# Render: ~/.agents/skills/d2-diagrams/scripts/render.sh docs/uinteger_t.d2
vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24 } }
direction: right

value: uinteger_t {
  limbs: "limb 0 (least significant) · limb 1 · … · limb n"
  label: "uinteger_t\nstd::vector<uint64_t>"
}

add: "+ −" {
  label: "add · sub\ncarry / borrow"
}
mul: "×" {
  label: "multiply · square\nschoolbook → Karatsuba\n→ Toom-3 → NTT"
}
div: "÷ %" {
  label: "divmod\nAlgorithm D → recursive\n(from 2048 bits)"
}
text: strings {
  label: "str · digits\nbases 2 … 36 · 2 … 256"
}

value -> add
value -> mul
value -> div
value -> text
