# uinteger_t: little-endian 64-bit limbs, and the algorithm each size gets.
# Render: ~/.agents/skills/d2-diagrams/scripts/render.sh docs/uinteger_t.d2
vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24; theme-overrides: { B1: "#8C7B7E"; B2: "#C25B73"; N2: "#C25B73" } } }
style.fill: transparent

direction: right

value: uinteger_t {
  limbs: "limb 0 (low) · limb 1 · … · limb n"
  label: "uinteger_t\nsmall vector of uint64_t"
}

add: "+ −" {
  label: "add · sub\ncarry / borrow"
}
mul: "×" {
  label: "multiply · square\nschoolbook → Karatsuba\n→ Toom-3 → Toom-4 → NTT"
}
div: "÷ %" {
  label: "divmod\nAlgorithm D → recursive\n→ reciprocal (Newton)"
}
text: strings {
  label: "str · digits\nbases 2 … 36 · 2 … 256"
}

value -> add
value -> mul
value -> div
value -> text
